<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS5 Cleanup"
        Width="1240" Height="900" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#141519" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- NEU 1.0.5: neue Oberfläche. Alle bisherigen Namen (x:Name) sind geblieben. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Hg" Color="#141519"/>
    <SolidColorBrush x:Key="Fl" Color="#1F2127"/>
    <SolidColorBrush x:Key="Fl2" Color="#2A2D35"/>
    <SolidColorBrush x:Key="Rand" Color="#30333C"/>
    <SolidColorBrush x:Key="RandKnopf" Color="#3A3E49"/>
    <SolidColorBrush x:Key="Text" Color="#E9EAEE"/>
    <SolidColorBrush x:Key="Grau" Color="#9CA1AD"/>
    <SolidColorBrush x:Key="Blau" Color="#3B8BFF"/>
    <SolidColorBrush x:Key="BlauKnopf" Color="#2F6FDB"/>
    <SolidColorBrush x:Key="Rot" Color="#8E2424"/>
    <SolidColorBrush x:Key="RotRand" Color="#B23434"/>
    <SolidColorBrush x:Key="Gelb" Color="#F2C46B"/>
    <SolidColorBrush x:Key="Gruen" Color="#6FD39E"/>
    <!-- Meldungsfarben: grün = geschützt, blau = Info, gelb = Hinweis, rot = endgültig -->
    <SolidColorBrush x:Key="GruenHg" Color="#14291F"/><SolidColorBrush x:Key="GruenRand" Color="#275C41"/><SolidColorBrush x:Key="GruenText" Color="#BFE8D2"/>
    <SolidColorBrush x:Key="BlauHg" Color="#16233A"/><SolidColorBrush x:Key="BlauRand" Color="#2C4A7A"/><SolidColorBrush x:Key="BlauText" Color="#C6DAFB"/>
    <SolidColorBrush x:Key="GelbHg" Color="#2E2512"/><SolidColorBrush x:Key="GelbRand" Color="#6B5320"/><SolidColorBrush x:Key="GelbText" Color="#F3DDA8"/>
    <SolidColorBrush x:Key="RotHg" Color="#351A1A"/><SolidColorBrush x:Key="RotRand2" Color="#8E2E2E"/><SolidColorBrush x:Key="RotText" Color="#F5C9C9"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <!-- NEU 1.0.6 (PS5-Test da_Chris86 30.10.2026 08:10): Infofenster dunkel wie die Oberfläche - vorher helle Schrift auf weißem Grund -->
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#2A2D35"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#4A4F5C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Fl2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RandKnopf}"/><Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#7FB2FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#15161A"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RandKnopf}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Background" Value="#15161A"/><Setter Property="Foreground" Value="{StaticResource BlauKnopf}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="Karte" TargetType="Border"><Setter Property="Background" Value="{StaticResource Fl}"/><Setter Property="BorderBrush" Value="{StaticResource Rand}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style x:Key="Etikett" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Grau}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Feld" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Grau}"/><Setter Property="Margin" Value="0,3,10,3"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Wert" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <!-- dunkle, schmale Scrollleisten (passend zur Oberfläche) -->
    <Style x:Key="Daumen" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="b" CornerRadius="4" Background="#4A4F5C" Margin="2"/>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6A7080"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Leer" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#191A1F" CornerRadius="6">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Leer}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Daumen}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Leer}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="#191A1F" CornerRadius="6">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Leer}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource Daumen}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Leer}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="Border"><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0,0,4,4"/></Style>
  </Window.Resources>

  <Grid x:Name="gAussen" Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Kopf -->
    <Border Grid.Row="0" Style="{StaticResource Karte}" BorderThickness="1,1,1,2" Padding="16,12" Margin="0,0,0,12">
      <Border.BorderBrush><SolidColorBrush Color="#2F6FDB"/></Border.BorderBrush>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="imLogo" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="PS5 Cleanup" VerticalAlignment="Center"/>
            <Border Background="#1B2A44" BorderBrush="#2C4A7A" BorderThickness="1" CornerRadius="9" Padding="9,1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="tbVersion" FontSize="11" FontWeight="SemiBold" Foreground="#9CC2FF" Text="1.0.5 Beta"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="tbKopf" Foreground="{StaticResource Grau}" FontSize="12.5" Margin="0,3,0,0"
                     Text="Löscht nur, was du auswählst. Kein Zurücksetzen, keine Neuinstallation: Systemsoftware, Laufwerks-Kopplung, Konto und echte Lizenzen bleiben. Benutzung auf eigene Gefahr - Gelöschtes ist endgültig weg."/>
          <TextBlock x:Name="tbUpdate" Margin="0,6,0,0" Visibility="Collapsed" Foreground="{StaticResource BlauText}"/>
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="btFeedback" Content="Feedback / Kompatibilität melden" ToolTip="Zeigt einen fertigen Bericht zum Prüfen. Gesendet wird nichts automatisch."/>
          <Button x:Name="btHilfe" Content="Hilfe"/>
          <Button x:Name="btSprache" Content="English"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Verbindung -->
    <Border Grid.Row="1" Style="{StaticResource Karte}" Padding="14,8" Margin="0,0,0,12">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock x:Name="tbIpText" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource Grau}" Text="IP der PS5:"/>
          <TextBox x:Name="tbIp" Width="170" VerticalAlignment="Center" Margin="0,4,4,4" ToolTip="PS5: Einstellungen > Netzwerk > Verbindungsstatus anzeigen. Anderer FTP-Port? Dann IP:Port"/>
          <Button x:Name="btSuchen" Content="PS5 im Netz suchen"/>
          <Button x:Name="btVerbinden" Content="Verbinden und nachschauen" Background="{StaticResource BlauKnopf}" BorderBrush="{StaticResource Blau}" FontWeight="SemiBold"/>
          <CheckBox x:Name="cbModell" IsChecked="True" VerticalAlignment="Center" Margin="10,4,14,4" Content="Modell automatisch erkennen"
                    ToolTip="Startet kurz das kleine Programm ps5info.elf auf der PS5 (Port 9021 oder 8084). Es legt dabei kurz die eigene Datei /data/ps5info.txt an - beides wird danach wieder entfernt."/>
          <Border Background="{StaticResource GruenHg}" BorderBrush="{StaticResource GruenRand}" BorderThickness="1" CornerRadius="16" Padding="12,4" Margin="0,4" VerticalAlignment="Center">
            <CheckBox x:Name="cbTest" IsChecked="True" Margin="0" FontWeight="SemiBold" Foreground="{StaticResource Gruen}"
                      Content="Testmodus: nur anschauen, nichts löschen" ToolTip="Solange der Haken gesetzt ist, sind die Lösch-Knöpfe gesperrt. Zum Löschen den Haken entfernen."/>
          </Border>
        </WrapPanel>
        <TextBlock x:Name="tbInfo" Margin="4,4,0,2" Foreground="{StaticResource Grau}" FontSize="12" Text="Nicht verbunden."/>
      </StackPanel>
    </Border>

    <!-- Hauptteil: links Konsole, rechts Bereinigung (schmale Fenster: Karten oben) -->
    <Grid x:Name="gHaupt" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="cdSeite" Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="rdOben" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <ScrollViewer x:Name="svSeite" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
        <StackPanel x:Name="wpSeite">

          <!-- Konsole -->
          <Border Style="{StaticResource Karte}" Padding="14,9" Margin="0,0,6,10">
            <StackPanel>
              <TextBlock x:Name="tbKonsoleKopf" Style="{StaticResource Etikett}" Text="KONSOLE"/>
              <TextBlock x:Name="tbReihe" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" Text="–"/>
              <TextBlock x:Name="tbModellNr" Foreground="{StaticResource Grau}" FontSize="12.5" Margin="0,0,0,3" Text="Noch nicht verbunden"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock x:Name="tbLFirmware" Style="{StaticResource Feld}" Text="Firmware"/>
                <TextBlock x:Name="tbFirmware" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
                <TextBlock x:Name="tbLErkannt" Grid.Row="1" Style="{StaticResource Feld}" Text="Modell erkannt" Visibility="Collapsed"/>
                <TextBlock x:Name="tbErkannt" Grid.Row="1" Grid.Column="1" Style="{StaticResource Wert}" Text="–" Visibility="Collapsed"/>
                <TextBlock x:Name="tbLVerbindung" Grid.Row="2" Style="{StaticResource Feld}" Text="Verbindung"/>
                <TextBlock x:Name="tbVerbindung" Grid.Row="2" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
              </Grid>
              <!-- NEU 1.0.6 (da_Chris86 28.10.2026): welcher Jailbreak-Einstieg - und was man dafür nicht löschen darf -->
              <TextBlock x:Name="tbJailbreak" FontSize="12.5" FontWeight="SemiBold" Foreground="#8FE0B5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
              <TextBlock x:Name="tbJailbreakWarnung" FontSize="11.5" Foreground="#FF9F66" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Laufwerks-Kopplung -->
          <Border x:Name="bdKopplung" Style="{StaticResource Karte}" Padding="14,9" Margin="0,0,6,10">
            <StackPanel>
              <TextBlock x:Name="tbKopplungKopf" Style="{StaticResource Etikett}" Text="LAUFWERKS-KOPPLUNG"/>
              <Grid Margin="0,7,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="bdKopplungSymbol" Width="34" Height="34" CornerRadius="17" BorderThickness="1" Background="#2A2D35" BorderBrush="#4A4F5C" VerticalAlignment="Top" Margin="0,0,12,0">
                  <TextBlock x:Name="tbKopplungSymbol" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C9CCD4" Text="&#xE9CE;"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="tbKopplungTitel" FontSize="14" FontWeight="SemiBold" Foreground="#C9CCD4" Text="Nicht abgefragt"/>
                  <TextBlock x:Name="tbKopplungText" FontSize="12" Foreground="{StaticResource Grau}" Text="Erst verbinden."/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="tbKopplungNie" FontSize="11.5" Foreground="{StaticResource Grau}" Text="Wird nur gelesen, nie verändert."/>
              <TextBlock x:Name="tbLegendeKopf" Style="{StaticResource Etikett}" Margin="0,8,0,4" Text="STATUSLEGENDE" Visibility="Collapsed"/>
              <WrapPanel Visibility="Collapsed">
                <Border Style="{StaticResource Chip}" Background="#173525"><TextBlock x:Name="tbLeg1" FontSize="10.5" Foreground="#8FE0B5" Text="Kopplung bestätigt"/></Border>
                <Border Style="{StaticResource Chip}" Background="#2A2D35"><TextBlock x:Name="tbLeg2" FontSize="10.5" Foreground="#C9CCD4" Text="Keine Kopplung"/></Border>
                <Border Style="{StaticResource Chip}" Background="#3A2E14"><TextBlock x:Name="tbLeg3" FontSize="10.5" Foreground="{StaticResource Gelb}" Text="Nicht sicher bestimmbar"/></Border>
                <Border Style="{StaticResource Chip}" Background="#22242A" BorderBrush="#4A4F5C" BorderThickness="1"><TextBlock x:Name="tbLeg4" FontSize="10.5" Foreground="#C9CCD4" Text="Nicht auslesbar / nicht abgefragt"/></Border>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Speicher -->
          <Border Style="{StaticResource Karte}" Padding="14,9" Margin="0,0,6,10">
            <StackPanel>
              <TextBlock x:Name="tbSpeicherKopf" Style="{StaticResource Etikett}" Text="SPEICHER"/>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock x:Name="tbLIntern" Style="{StaticResource Feld}" Text="Intern"/>
                <TextBlock x:Name="tbIntern" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
                <TextBlock x:Name="tbLM2" Grid.Row="1" Style="{StaticResource Feld}" Text="M.2-SSD"/>
                <TextBlock x:Name="tbM2" Grid.Row="1" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
                <TextBlock x:Name="tbLUsb" Grid.Row="2" Style="{StaticResource Feld}" Text="USB"/>
                <TextBlock x:Name="tbUsb" Grid.Row="2" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
                <TextBlock x:Name="tbLSm" Grid.Row="3" Style="{StaticResource Feld}" Text="ShadowMount"/>
                <TextBlock x:Name="tbSm" Grid.Row="3" Grid.Column="1" Style="{StaticResource Wert}" Text="–"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- rechts: Bereinigung, Trennlinie, Protokoll (die linke Spalte nutzt die ganze Höhe) -->
      <Grid x:Name="gRechts" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="180"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="rdProtokoll" Height="Auto"/>
      </Grid.RowDefinitions>
      <!-- Bereinigung -->
      <Border x:Name="bdBereinigung" Grid.Row="0" Style="{StaticResource Karte}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Margin="18,12,18,8">
            <TextBlock x:Name="tbBereinigungKopf" FontSize="16" FontWeight="SemiBold" Margin="0,0,12,0" Text="Bereinigung"/>
            <TextBlock x:Name="tbFundInfo" Foreground="{StaticResource Grau}" VerticalAlignment="Bottom" Text=""/>
          </WrapPanel>
          <Border x:Name="bdTest" Grid.Row="1" Margin="18,0,18,8" Padding="12,8" CornerRadius="10" BorderThickness="1" Background="{StaticResource GruenHg}" BorderBrush="{StaticResource GruenRand}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Gruen}" Margin="0,1,10,0" Text="&#xE83D;"/>
              <TextBlock x:Name="tbTestHinweis" Foreground="{StaticResource GruenText}" Text="Testmodus aktiv: Es wird nichts gelöscht - die Lösch-Knöpfe sind gesperrt. Zum Löschen den Haken „Testmodus“ entfernen."/>
            </DockPanel>
          </Border>
          <!-- NEU 1.0.5: rot, solange gelöscht wird -->
          <Border x:Name="bdLaeuft" Grid.Row="1" Margin="18,0,18,8" Padding="12,8" CornerRadius="10" BorderThickness="1" Background="{StaticResource RotHg}" BorderBrush="{StaticResource RotRand2}" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF8A8A" Margin="0,1,10,0" Text="&#xE7BA;"/>
              <TextBlock x:Name="tbLaeuft" Foreground="{StaticResource RotText}" Text="Löschen läuft - bitte warten, bis „Fertig“ erscheint. Was schon gelöscht ist, bleibt gelöscht - auch ein Fehler oder Abbruch bringt nichts zurück. Damit kein Spiel nur halb gelöscht zurückbleibt, lässt sich das Fenster bis dahin nicht schließen."/>
            </DockPanel>
          </Border>
          <Border x:Name="bdHinweis" Grid.Row="2" Margin="18,0,18,8" Padding="12,8" CornerRadius="10" BorderThickness="1" Background="{StaticResource GelbHg}" BorderBrush="{StaticResource GelbRand}" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Gelb}" Margin="0,1,10,0" Text="&#xE7BA;"/>
              <TextBlock x:Name="tbHinweis" Foreground="{StaticResource GelbText}"/>
            </DockPanel>
          </Border>
          <Border Grid.Row="3" BorderBrush="{StaticResource Fl2}" BorderThickness="0,1,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="spBereiche" Margin="14,6,14,8">
                <TextBlock x:Name="tbLeer" Foreground="{StaticResource Grau}" Margin="4,8,4,8" Text="Erst verbinden - dann erscheint hier, was auf der PS5 gelöscht werden kann."/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="4" Margin="14,8,14,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Grid.ColumnSpan="4" x:Name="pbFortschritt" Height="6" Margin="4,0,4,8" Minimum="0" Maximum="100"/>
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="tbStand" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource Grau}"/>
            <Button Grid.Row="1" Grid.Column="1" x:Name="btAbbrechen" Content="Abbrechen" Visibility="Collapsed" Background="#4A4F5C" BorderBrush="#5A5E6B"
                    ToolTip="Hält das Suchen oder Zählen an. Gelöscht wird dabei nichts."/>
            <Button Grid.Row="1" Grid.Column="2" x:Name="btAuswahl" Content="Nur Auswahl löschen" IsEnabled="False"/>
            <Button Grid.Row="1" Grid.Column="3" x:Name="btKomplett" Content="Vollständige Bereinigung" Background="{StaticResource Rot}" BorderBrush="{StaticResource RotRand}" FontWeight="SemiBold" IsEnabled="False"
                    ToolTip="Alles auf der internen SSD (die M.2 wird extra gefragt). Danach kommt noch eine Abschlussfrage mit Eingabe von LÖSCHEN."/>
          </Grid>
        </Grid>
      </Border>
      <!-- NEU 1.0.5: Trennlinie - mit der Maus ziehen, um das Protokoll größer oder kleiner zu machen -->
      <GridSplitter x:Name="gsProtokoll" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                    Background="Transparent" Cursor="SizeNS" ToolTip="Ziehen, um das Protokoll größer oder kleiner zu machen">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent"><Border Height="4" Width="60" CornerRadius="2" Background="#3A3E49" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!-- Protokoll (einklappbar) -->
      <Border Grid.Row="2" Style="{StaticResource Karte}" Padding="10,4,10,8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Expander x:Name="exProtokoll" IsExpanded="True" Margin="0,2,0,0">
            <Expander.Header><TextBlock x:Name="tbProtokollKopf" FontWeight="SemiBold" Text="Protokoll"/></Expander.Header>
            <TextBox x:Name="tbLog" MinHeight="60" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderThickness="0"/>
          </Expander>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="btLogKopie" Margin="0,0,6,0" MinHeight="30" Padding="12,4" Content="Alles kopieren" ToolTip="Kopiert das ganze Protokoll dieser Sitzung in die Zwischenablage - nicht nur den sichtbaren Teil."/>
